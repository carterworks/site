{
  "name": "site",
  "version": "6.3.1",
  "private": true,
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.3",
    "@astrojs/sitemap": "3.7.3",
    "feed": "5.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "module": "src/index.astro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carterworks/site.git"
  },
  "scripts": {
    "dev": "DEV=true astro dev",
    "start": "DEV=true astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets": "nub scripts/assets.mjs",
    "media:markup": "nub scripts/media-markup.mjs",
    "cf-typegen": "wrangler types",
    "format": "oxfmt --write .",
    "check": "astro check && tsc --noEmit",
    "deploy": "astro build && wrangler pages deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/ts-plugin": "1.10.10",
    "@types/node": "25.9.3",
    "astro": "7.0.6",
    "oxfmt": "0.55.0",
    "sharp": "0.35.1",
    "takumi-js": "2.0.0-rc.9",
    "typescript": "6.0.3",
    "wrangler": "4.102.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "."
  ],
  "overrides": {
    "astro-remark-eleventy-image>sharp": "0.35.1",
    "devalue": ">=5.8.1",
    "esbuild": "0.28.1",
    "fast-uri": ">=3.1.2",
    "fast-xml-builder": ">=1.1.7",
    "yaml": ">=2.8.3"
  },
  "allowBuilds": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
