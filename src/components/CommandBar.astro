---
import { getPostTitle, getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();
const sitemapPages = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Writing" },
  ...posts.map((post) => ({ href: `/blog/${post.id}/`, label: getPostTitle(post) })),
];
---

<command-bar>
  <button
    class="command-trigger"
    type="button"
    commandfor="command-dialog"
    command="show-modal"
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <span>Navigate</span>
    <kbd class="shortcut">⌘ K</kbd>
  </button>

  <dialog id="command-dialog" closedby="any" aria-label="Navigate">
    <search class="search-row" aria-label="Command palette">
      <span data-search-icon aria-hidden="true">/</span>
      <button data-back type="button" aria-label="Back to all commands" hidden>
        <span aria-hidden="true">←</span>
      </button>
      <input
        id="command-search"
        type="search"
        aria-label="Search commands"
        aria-controls="command-root"
        placeholder="Search commands"
        autocomplete="off"
        autofocus
      />
      <button
        type="button"
        commandfor="command-dialog"
        command="request-close"
        aria-label="Close command bar"
        data-close
      >
        <kbd aria-hidden="true">esc</kbd>
      </button>
    </search>

    <div id="command-root" class="commands panel" data-panel="root">
      <section data-group>
        <h2 class="group-label">Actions</h2>
        <div>
          <button
            type="button"
            data-command
            data-settings
            data-search="settings appearance theme light dark"
          >
            <span>Settings</span><span class="command-detail" aria-hidden="true">›</span>
          </button>
        </div>
      </section>

      <section data-group>
        <h2 class="group-label">Links on this page</h2>
        <div data-page-links></div>
      </section>

      <section data-group>
        <h2 class="group-label">Sitemap</h2>
        <div>
          {
            sitemapPages.map(({ href, label }) => (
              <a
                href={href}
                data-command
                data-sitemap
                data-search={`${label} ${href}`.toLowerCase()}
              >
                <span>{label}</span><span class="command-detail">{href}</span>
              </a>
            ))
          }
        </div>
      </section>

      <output class="empty" for="command-search" hidden>No matching commands</output>
    </div>

    <div
      id="command-settings-menu"
      class="commands panel"
      data-panel="settings"
      hidden
    >
      <section data-group>
        <h2 class="group-label">Settings</h2>
        <div>
          <button
            type="button"
            aria-pressed="false"
            data-command
            data-appearance
            data-search="toggle appearance theme light dark"
          >
            <span>Dark mode</span><span class="command-detail" data-scheme aria-live="polite"></span>
          </button>
        </div>
      </section>
      <output class="empty" for="command-search" hidden>No matching commands</output>
    </div>

    <div class="command-help">
      <span data-root-help><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span data-root-help><kbd>↵</kbd> open</span>
      <span data-settings-help hidden><kbd>⇧</kbd> <kbd>↵</kbd> toggle and stay</span>
      <span data-settings-help hidden><kbd>↵</kbd> toggle and close</span>
    </div>
  </dialog>
</command-bar>

<script>
  import "./command-bar";
</script>

<style>
  command-bar {
    color: var(--color-text);
    display: block;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.3;
    inset: auto max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) auto;
    position: fixed;
    z-index: 10;
  }

  command-bar :is(a, button, input) {
    color: inherit;
    font: inherit;
  }

  command-bar button {
    border: 0;
    cursor: pointer;
  }

  .command-trigger {
    align-items: center;
    background: transparent;
    display: flex;
    gap: var(--size-md);
    padding: var(--size-sm) 0;
  }

  .command-trigger kbd {
    margin-inline-start: var(--size-sm);
  }

  command-bar kbd {
    font: inherit;
  }

  dialog {
    background: var(--color-bg);
    border: 0;
    color: inherit;
    inline-size: min(34rem, calc(100% - 2rem));
    inset: min(20svh, 10rem) 0 auto;
    margin: 0 auto;
    max-block-size: min(36rem, calc(100svh - 2rem));
    overflow: hidden;
    padding: 0;
    position: fixed;
  }

  dialog:open {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  dialog::backdrop {
    background: light-dark(rgb(0 0 0 / 5%), rgb(0 0 0 / 18%));
  }

  .search-row {
    align-items: center;
    border-block-end: 1px solid currentColor;
    display: grid;
    gap: var(--size-md);
    grid-template-columns: auto minmax(0, 1fr) auto;
    padding: var(--size-md);
  }

  .search-row > button:not([hidden]) {
    align-items: center;
    background: transparent;
    display: flex;
    margin: calc(-1 * var(--size-sm));
    padding: var(--size-sm);
  }

  .search-row > [data-search-icon][hidden] {
    display: none;
  }

  dialog input {
    background: transparent;
    border: 0;
    outline: 0;
  }

  dialog input::placeholder {
    color: inherit;
    opacity: 1;
  }

  .commands {
    counter-reset: command-group;
    min-block-size: 0;
    overflow-y: auto;
    padding-block: var(--size-sm);
  }

  .commands section {
    counter-increment: command-group;
  }

  .commands section + section {
    margin-block-start: var(--size-xs);
  }

  .commands section > div {
    border-inline-start: 1px solid currentColor;
    margin-inline: var(--size-md);
  }

  .commands :global([data-command]:not([hidden])) {
    align-items: baseline;
    background: transparent;
    border-radius: 0;
    color: inherit;
    display: grid;
    gap: var(--size-sm);
    grid-template-columns: 1ch minmax(0, 1fr) auto;
    padding: var(--size-xs) 0 var(--size-xs) var(--size-sm);
    text-align: start;
    text-decoration: none;
    inline-size: 100%;
  }

  .commands :global([data-command]::before) {
    content: "";
  }

  .commands :global([data-command]::after) {
    content: none;
  }

  .commands :global([data-command][data-active]::before) {
    content: "→";
  }

  .commands :global([data-command][data-active] > span:first-child) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .commands :global([data-command] > span) {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .commands :global(.command-detail) {
    justify-self: end;
    max-inline-size: 18ch;
    overflow: hidden;
    text-align: end;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .group-label {
    font: inherit;
    padding: var(--size-xs) var(--size-md);
  }

  .group-label::before {
    content: counter(command-group, decimal-leading-zero) " / ";
  }

  .empty {
    color: inherit;
    padding: var(--size-lg) var(--size-md);
    text-align: center;
  }

  .command-help {
    border-block-start: 1px solid currentColor;
    display: flex;
    gap: var(--size-md);
    justify-content: flex-end;
    padding: var(--size-sm) var(--size-md);
  }

  command-bar :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .command-trigger:active {
    transform: scale(0.97);
  }

  @media (width <= 480px) {
    command-bar {
      inset-inline: 1rem;
    }

    .command-trigger {
      justify-content: center;
      margin-inline-start: auto;
    }

    dialog {
      inline-size: calc(100% - 2rem);
      inset-block-start: 1rem;
      max-block-size: 70svh;
    }

    .command-help {
      display: none;
    }
  }
</style>
