---
import { getPostTitle, getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();
const sitemapPages = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Writing" },
  ...posts.map((post) => ({ href: `/blog/${post.id}/`, label: getPostTitle(post) })),
];
---

<command-bar>
  <button
    class="command-trigger"
    type="button"
    commandfor="command-dialog"
    command="show-modal"
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="6" />
      <path d="m16 16 4 4" />
    </svg>
    <span>Navigate</span>
    <kbd class="shortcut">⌘ K</kbd>
  </button>

  <dialog id="command-dialog" closedby="any" aria-label="Navigate">
    <search class="search-row" aria-label="Command palette">
      <svg data-search-icon aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="6" />
        <path d="m16 16 4 4" />
      </svg>
      <button data-back type="button" aria-label="Back to all commands" hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <input
        id="command-search"
        type="search"
        aria-label="Search commands"
        aria-controls="command-root"
        placeholder="Search commands"
        autocomplete="off"
        autofocus
      />
      <button
        type="button"
        commandfor="command-dialog"
        command="request-close"
        aria-label="Close command bar"
        data-close
      >
        <kbd aria-hidden="true">esc</kbd>
      </button>
    </search>

    <div id="command-root" class="commands panel" data-panel="root">
      <section data-group>
        <h2 class="group-label">Actions</h2>
        <button
          type="button"
          data-command
          data-settings
          data-search="settings appearance theme light dark"
        >
          <span>Settings</span><span class="command-detail" aria-hidden="true">›</span>
        </button>
      </section>

      <section data-group>
        <h2 class="group-label">Links on this page</h2>
        <div data-page-links></div>
      </section>

      <section data-group>
        <h2 class="group-label">Sitemap</h2>
        <div>
          {
            sitemapPages.map(({ href, label }) => (
              <a
                href={href}
                data-command
                data-sitemap
                data-search={`${label} ${href}`.toLowerCase()}
              >
                <span>{label}</span><span class="command-detail">{href}</span>
              </a>
            ))
          }
        </div>
      </section>

      <output class="empty" for="command-search" hidden>No matching commands</output>
    </div>

    <div
      id="command-settings-menu"
      class="commands panel"
      data-panel="settings"
      hidden
    >
      <section data-group>
        <h2 class="group-label">Settings</h2>
        <button
          type="button"
          aria-pressed="false"
          data-command
          data-appearance
          data-search="toggle appearance theme light dark"
        >
          <span>Dark mode</span><span class="command-detail" data-scheme aria-live="polite"></span>
        </button>
      </section>
      <output class="empty" for="command-search" hidden>No matching commands</output>
    </div>

    <div class="command-help">
      <span data-root-help><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span data-root-help><kbd>↵</kbd> open</span>
      <span data-settings-help hidden><kbd>⇧</kbd> <kbd>↵</kbd> toggle and stay</span>
      <span data-settings-help hidden><kbd>↵</kbd> toggle and close</span>
    </div>
  </dialog>
</command-bar>

<script>
  class CommandBarElement extends HTMLElement {
    private shortcutHandler?: (event: KeyboardEvent) => void;

    connectedCallback() {
      if (this.dataset.ready) {
        if (this.shortcutHandler) document.addEventListener("keydown", this.shortcutHandler);
        return;
      }
      const dialog = this.querySelector<HTMLDialogElement>("dialog");
      const trigger = this.querySelector<HTMLButtonElement>(".command-trigger");
      const input = this.querySelector<HTMLInputElement>("input");
      const back = this.querySelector<HTMLButtonElement>("[data-back]");
      const close = this.querySelector<HTMLButtonElement>("[data-close]");
      const searchIcon = this.querySelector<SVGElement>("[data-search-icon]");
      const pageLinks = this.querySelector<HTMLElement>("[data-page-links]");
      const appearance = this.querySelector<HTMLButtonElement>("[data-appearance]");
      const scheme = this.querySelector<HTMLElement>("[data-scheme]");
      const rootPanel = this.querySelector<HTMLElement>('[data-panel="root"]');
      const settingsPanel = this.querySelector<HTMLElement>('[data-panel="settings"]');
      if (
        !dialog ||
        !trigger ||
        !input ||
        !back ||
        !close ||
        !searchIcon ||
        !pageLinks ||
        !appearance ||
        !scheme ||
        !rootPanel ||
        !settingsPanel
      ) {
        return;
      }

      this.dataset.ready = "true";

      const panels = { root: rootPanel, settings: settingsPanel };
      let activePanel: keyof typeof panels = "root";
      const supportsInvokerCommands = "commandForElement" in trigger;

      if (!navigator.platform.toLowerCase().includes("mac")) {
        const shortcut = this.querySelector<HTMLElement>(".shortcut");
        if (shortcut) shortcut.textContent = "Ctrl K";
      }

      const panel = () => panels[activePanel];
      const commands = () => [...panel().querySelectorAll<HTMLElement>("[data-command]")];
      const visibleCommands = () => commands().filter((command) => !command.hidden);
      const absoluteUrl = (href: string) => new URL(href, location.href).href;
      const commandFrom = (target: EventTarget | null) =>
        target instanceof Element ? target.closest<HTMLElement>("[data-command]") : null;

      const createLink = (href: string, label: string, detail: string) => {
        const link = document.createElement("a");
        link.href = href;
        link.dataset.command = "";
        link.dataset.search = `${label} ${href}`.toLowerCase();
        const name = document.createElement("span");
        const destination = document.createElement("span");
        destination.className = "command-detail";
        name.textContent = label;
        destination.textContent = detail;
        link.appendChild(name);
        link.appendChild(destination);
        return link;
      };

      const select = (command?: HTMLElement, focus = false) => {
        this.querySelectorAll<HTMLElement>("[data-command]").forEach((item) => {
          item.toggleAttribute("data-active", item === command);
        });
        if (focus) command?.focus();
      };

      const filter = () => {
        const words = input.value.toLowerCase().match(/\S+/g) ?? [];
        commands().forEach((command) => {
          const matches = words.every((word) => (command.dataset.search ?? "").includes(word));
          command.hidden = !matches;
        });
        panel().querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
          group.hidden = !group.querySelector("[data-command]:not([hidden])");
        });
        const visible = visibleCommands();
        const empty = panel().querySelector<HTMLElement>(".empty");
        if (empty) empty.hidden = visible.length !== 0;
        select(visible[0]);
      };

      const showPanel = (name: keyof typeof panels) => {
        activePanel = name;
        Object.entries(panels).forEach(([panelName, item]) => {
          item.hidden = panelName !== name;
        });
        back.hidden = name === "root";
        searchIcon.toggleAttribute("hidden", name !== "root");
        input.value = "";
        const searchLabel = name === "root" ? "Search commands" : "Search settings";
        input.placeholder = searchLabel;
        input.setAttribute("aria-label", searchLabel);
        input.setAttribute("aria-controls", name === "root" ? "command-root" : "command-settings-menu");
        this.querySelectorAll<HTMLElement>("[data-root-help]").forEach((item) => (item.hidden = name !== "root"));
        this.querySelectorAll<HTMLElement>("[data-settings-help]").forEach(
          (item) => (item.hidden = name === "root"),
        );
        filter();
        input.focus();
      };

      const rebuildPageLinks = () => {
        pageLinks.replaceChildren();
        const sourceLinks = [...document.querySelectorAll<HTMLAnchorElement>("body a[href]")].filter(
          (link) => !this.contains(link),
        );
        const sitemapLinks = [...this.querySelectorAll<HTMLAnchorElement>("[data-sitemap]")];
        const sitemapUrls = new Set(sitemapLinks.map((link) => absoluteUrl(link.href)));
        const pageOnlyLinks = sourceLinks.filter((source) => !sitemapUrls.has(absoluteUrl(source.href)));

        pageOnlyLinks.forEach((source) => {
          const label = (source.getAttribute("aria-label") || source.textContent || source.href)
            .replace(/\s+/g, " ")
            .trim();
          const url = new URL(source.href);
          const detail =
            url.origin === location.origin
              ? `${url.pathname}${url.search}${url.hash}`
              : url.hostname.replace(/^www\./, "") || url.protocol.slice(0, -1);
          pageLinks.appendChild(createLink(source.href, label, detail));
        });
      };

      const currentScheme = () =>
        document.documentElement.style.colorScheme ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

      const updateSchemeLabel = () => {
        const dark = currentScheme() === "dark";
        scheme.textContent = dark ? "On" : "Off";
        appearance.setAttribute("aria-pressed", String(dark));
      };

      const toggleAppearance = (close: boolean) => {
        document.documentElement.style.colorScheme = currentScheme() === "dark" ? "light" : "dark";
        updateSchemeLabel();
        if (close) dialog.close();
      };

      const prepare = () => {
        rebuildPageLinks();
        updateSchemeLabel();
        showPanel("root");
        if (!supportsInvokerCommands) dialog.showModal();
      };

      const move = (direction: number) => {
        const visible = visibleCommands();
        if (!visible.length) return;
        const current = visible.indexOf(document.activeElement as HTMLElement);
        const next = current === -1 ? (direction > 0 ? 0 : visible.length - 1) : (current + direction + visible.length) % visible.length;
        select(visible[next], true);
        visible[next].scrollIntoView({ block: "nearest" });
      };

      trigger.addEventListener("click", prepare);
      back.addEventListener("click", () => showPanel("root"));
      close.addEventListener("click", () => {
        if (supportsInvokerCommands) return;
        if (activePanel === "settings") showPanel("root");
        else dialog.close();
      });
      input.addEventListener("input", filter);
      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          move(event.key === "ArrowDown" ? 1 : -1);
        }
        if (event.key === "Enter") {
          event.preventDefault();
          if (event.shiftKey && activePanel === "settings") {
            toggleAppearance(false);
            return;
          }
          visibleCommands().find((command) => command.hasAttribute("data-active"))?.click();
        }
      });
      this.addEventListener("keydown", (event) => {
        const command = commandFrom(event.target);
        if (!command || !panel().contains(command)) return;
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          move(event.key === "ArrowDown" ? 1 : -1);
        }
        if (event.key === "Enter" && event.shiftKey && activePanel === "settings") {
          event.preventDefault();
          toggleAppearance(false);
        }
      });
      dialog.addEventListener("cancel", (event) => {
        if (activePanel === "settings") {
          event.preventDefault();
          showPanel("root");
        }
      });
      this.addEventListener("pointermove", (event) => {
        const command = commandFrom(event.target);
        if (command && panel().contains(command)) select(command);
      });
      this.addEventListener("focusin", (event) => {
        const command = commandFrom(event.target);
        if (command && panel().contains(command)) select(command);
      });
      this.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const target = event.target;
        if (target.closest("[data-settings]")) showPanel("settings");
        if (target.closest("[data-appearance]")) toggleAppearance(true);
      });
      this.shortcutHandler = (event) => {
        if (
          !event.altKey &&
          !event.shiftKey &&
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          if (!dialog.open) trigger.click();
        }
      };
      document.addEventListener("keydown", this.shortcutHandler);
    }

    disconnectedCallback() {
      if (this.shortcutHandler) document.removeEventListener("keydown", this.shortcutHandler);
    }
  }

  if (!customElements.get("command-bar")) {
    customElements.define("command-bar", CommandBarElement);
  }
</script>

<style>
  command-bar {
    --bar-surface: var(--color-bg);
    --bar-border: light-dark(rgb(0 0 0 / 14%), rgb(255 255 255 / 16%));
    --bar-muted: light-dark(#626262, #b8b8b8);
    color: var(--color-text);
    display: block;
    font-size: 0.875rem;
    inset: auto max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) auto;
    position: fixed;
    z-index: 10;
  }

  command-bar :is(a, button, input) {
    color: inherit;
    font: inherit;
  }

  command-bar button {
    border: 0;
    cursor: pointer;
  }

  command-bar svg {
    fill: none;
    inline-size: 1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .command-trigger {
    align-items: center;
    background: transparent;
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0;
  }

  .command-trigger > span {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .command-trigger kbd {
    margin-inline-start: 0.35rem;
  }

  command-bar kbd {
    color: var(--bar-muted);
    font: 0.75rem/1 "InterVariable", sans-serif;
  }

  dialog {
    background: var(--bar-surface);
    border: 1px solid var(--bar-border);
    border-radius: 0.25rem;
    color: inherit;
    inline-size: min(34rem, calc(100% - 2rem));
    inset: min(20svh, 10rem) 0 auto;
    margin: 0 auto;
    max-block-size: min(36rem, calc(100svh - 2rem));
    overflow: hidden;
    padding: 0;
    position: fixed;
  }

  dialog:open {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  dialog::backdrop {
    background: light-dark(rgb(0 0 0 / 5%), rgb(0 0 0 / 18%));
  }

  .search-row {
    align-items: center;
    border-block-end: 1px solid var(--bar-border);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    padding: 0.75rem 0.9rem;
  }

  .search-row > button:not([hidden]) {
    align-items: center;
    background: transparent;
    display: flex;
    margin: -0.35rem;
    padding: 0.35rem;
  }

  .search-row > svg[hidden] {
    display: none;
  }

  dialog input {
    background: transparent;
    border: 0;
    outline: 0;
  }

  dialog input::placeholder,
  .commands :global(.command-detail),
  .group-label,
  .command-help {
    color: var(--bar-muted);
  }

  .commands {
    min-block-size: 0;
    overflow-y: auto;
    padding-block: 0.35rem;
  }

  .commands :global([data-command]:not([hidden])) {
    align-items: baseline;
    background: transparent;
    border-radius: 0;
    color: inherit;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.6rem 0.9rem;
    text-align: start;
    text-decoration: none;
    inline-size: 100%;
  }

  .commands :global([data-command]::after) {
    content: none;
  }

  .commands :global([data-command][data-active]) {
    background: light-dark(rgb(0 0 0 / 7%), rgb(255 255 255 / 9%));
  }

  .commands :global([data-command] > span) {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .commands :global(.command-detail) {
    flex: none;
    font-size: 0.75rem;
    max-inline-size: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .group-label {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.65rem 0.9rem 0.25rem;
  }

  .empty {
    color: var(--bar-muted);
    padding: 2rem 0.65rem;
    text-align: center;
  }

  .command-help {
    border-block-start: 1px solid var(--bar-border);
    display: flex;
    font-size: 0.75rem;
    gap: 1rem;
    justify-content: flex-end;
    padding: 0.55rem 0.9rem;
  }

  command-bar :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .command-trigger:active {
    transform: scale(0.97);
  }

  @media (width <= 480px) {
    command-bar {
      inset-inline: 1rem;
    }

    .command-trigger {
      justify-content: center;
      margin-inline-start: auto;
    }

    dialog {
      border-radius: 0;
      inline-size: calc(100% - 2rem);
      inset-block-start: 1rem;
      max-block-size: 70svh;
    }

    .command-help {
      display: none;
    }
  }
</style>
