---
import { getPostTitle, getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();
const sitemapPages = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Writing" },
  ...posts.map((post) => ({
    href: `/blog/${post.id}/`,
    label: getPostTitle(post),
  })),
];
---

<command-bar>
  <label class="command-label" for="command-navigate">Navigate</label>
  <input
    id="command-navigate"
    class="command-trigger"
    type="search"
    aria-controls="command-dialog"
    aria-haspopup="dialog"
    accesskey="k"
    placeholder="Navigate"
  />

  <dialog id="command-dialog" popover aria-label="Navigate">
    <button class="panel-back" data-back type="button" hidden>← Back</button>

    <div id="command-root" class="commands panel stack" data-panel="root">
      <section data-group>
        <h2 class="group-label">Actions</h2>
        <ul>
          <li>
            <button
              type="button"
              data-command
              data-settings
              data-search="settings appearance theme light dark"
            >
              <span>Settings</span><span
                class="command-detail"
                aria-hidden="true">›</span
              >
            </button>
          </li>
        </ul>
      </section>

      <section data-group>
        <h2 class="group-label">Links on this page</h2>
        <ul data-page-links></ul>
      </section>

      <section data-group>
        <h2 class="group-label">Sitemap</h2>
        <ul>
          {
            sitemapPages.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  data-command
                  data-sitemap
                  data-search={`${label} ${href}`.toLowerCase()}
                >
                  <span>{label}</span>
                  <span class="command-separator" aria-hidden="true">
                    {" — "}
                  </span>
                  <span class="command-detail">{href}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <output class="empty" hidden>No matching commands</output>
    </div>

    <div
      id="command-settings-menu"
      class="commands panel stack"
      data-panel="settings"
      hidden
    >
      <section data-group>
        <h2 class="group-label">Settings</h2>
        <ul>
          <li>
            <button
              type="button"
              aria-pressed="false"
              data-command
              data-appearance
              data-search="toggle appearance theme light dark"
            >
              <span>Dark mode</span><span
                class="command-detail"
                data-scheme
                aria-live="polite"></span>
            </button>
          </li>
        </ul>
      </section>
      <output class="empty" hidden>No matching commands</output>
    </div>
  </dialog>
</command-bar>

<script>
  import "./command-bar";
</script>

<style>
  command-bar {
    align-items: center;
    color: var(--color-text);
    display: flex;
    font-size: 0.875rem;
    font-weight: 400;
    gap: var(--size-sm);
    line-height: 1.3;
  }

  dialog :is(button, input) {
    color: inherit;
    font: inherit;
  }

  dialog button {
    border: 0;
    cursor: pointer;
  }

  .command-trigger {
    anchor-name: --command-trigger;
    font-size: 1rem;
    inline-size: min(12rem, 50vw);
  }

  .command-label {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  dialog {
    --command-dialog-offset: min(20svh, 10rem);

    background: var(--color-bg);
    border: 1px solid currentColor;
    color: inherit;
    inline-size: min(30rem, calc(100% - 2rem));
    inset: var(--command-dialog-offset) 0 auto;
    margin: 0 auto;
    max-block-size: min(
      30rem,
      calc(100svh - var(--command-dialog-offset) - 1rem)
    );
    overflow-y: auto;
    padding-block: var(--size-xs);
    position: fixed;
  }

  dialog:popover-open {
    display: block;
  }

  dialog::backdrop {
    background: light-dark(rgb(0 0 0 / 15%), rgb(0 0 0 / 30%));
  }

  .panel-back:not([hidden]) {
    background: transparent;
    display: block;
    inline-size: 100%;
    padding: var(--size-xs) var(--size-sm);
    text-align: start;
  }

  .commands {
    --flow-space: var(--size-xs);

    padding-block: var(--size-xs);
  }

  .commands ul {
    list-style: none;
  }

  .commands :global([data-command]:not([hidden])) {
    align-items: baseline;
    background: transparent;
    border-radius: 0;
    display: grid;
    gap: var(--size-sm);
    grid-template-columns: minmax(0, 1fr) auto;
    padding: var(--size-xs) var(--size-sm);
    text-align: start;
    inline-size: 100%;
  }

  .commands :global([data-command]::after) {
    content: none;
  }

  .commands :global([data-command][data-active]) {
    outline: 1px dotted currentColor;
    outline-offset: -1px;
  }

  .commands :global([data-command] > span) {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .commands :global(.command-detail) {
    justify-self: end;
    max-inline-size: 18ch;
    overflow: hidden;
    text-align: end;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .commands :global(.command-separator) {
    display: none;
  }

  .group-label {
    font-size: inherit;
    padding: var(--size-xs) var(--size-sm);
  }

  .empty {
    color: inherit;
    padding: var(--size-lg) var(--size-md);
    text-align: center;
  }

  dialog :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (min-height: 40rem) {
    @supports (position-area: block-end) {
      dialog {
        inset: auto;
        justify-self: end;
        margin: var(--size-sm) 0 0;
        max-block-size: min(30rem, calc(100svh - 2rem));
        position-anchor: --command-trigger;
        position-area: block-end span-inline-start;
        position-try: flip-block;
      }
    }
  }
</style>
