<play-toolbar role="group" aria-label="Playground">
  <label><span>Toy</span> <select data-toy></select></label>
  <button type="button" data-image>Image…</button>
  <input type="file" accept="image/*" hidden />
  <label><span>Display</span> <select data-display></select></label>
  <label
    ><span>Shape</span>
    <select data-shape></select></label
  >
  <label><span>Cells</span> <select data-cells></select></label>
  <button type="button" data-theme>Theme</button>
  <a href="/">Home</a>
  <div class="notes">
    <p class="paused-notice">Toys are paused for reduced motion.</p>
    <p role="status" data-status></p>
  </div>
  <div class="fps" data-fps hidden>
    <p data-fps-rate></p>
    <p data-fps-low></p>
    <svg viewBox="0 0 60 1" preserveAspectRatio="none" aria-hidden="true">
      <polyline data-fps-history></polyline>
    </svg>
  </div>
</play-toolbar>

<script>
  import "./play-toolbar";
</script>

<style>
  /*
   * At the top, as wide as its controls, so the backdrop keeps the rest of
   * the screen. On a narrow screen the controls wrap into full rows.
   */
  play-toolbar {
    background: var(--color-bg);
    border-radius: var(--size-sm);
    color: var(--color-text);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    gap: var(--size-2xs);
    inline-size: fit-content;
    inset: max(var(--size-sm), env(safe-area-inset-top)) var(--size-sm) auto;
    margin-inline: auto;
    padding: var(--size-2xs);
    position: fixed;
    z-index: 1;
  }

  /* Wrapping alone strands the last control on a row of its own. */
  @media (width < 48rem) {
    play-toolbar {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      inline-size: auto;
      max-inline-size: 30rem;
    }

    play-toolbar > * {
      grid-column: span 2;
    }

    label:has([data-toy]) {
      grid-column: span 4;
    }

    label:has([data-display], [data-shape]) {
      grid-column: span 3;
    }
  }

  button,
  label,
  a {
    align-items: center;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    flex: 1 1 auto;
    font: inherit;
    gap: 0.5em;
    justify-content: center;
    min-block-size: 2.75rem;
    padding: 0 var(--size-xs);
    text-decoration: none;
    white-space: nowrap;
  }

  label span {
    opacity: 0.7;
  }

  /* Wide enough for "Light" and "Dark" alike, so a press never moves the bar. */
  [data-theme] {
    min-inline-size: 7.5em;
  }

  select {
    background: transparent;
    block-size: 2.75rem;
    border: 0;
    color: inherit;
    cursor: inherit;
    flex: 1;
    font: inherit;
    min-inline-size: 0;
    outline: none;
  }

  option {
    background: var(--color-bg);
    color: var(--color-text);
  }

  :is(button, a):focus-visible,
  label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .notes {
    inset: calc(100% + var(--size-2xs)) 0 auto;
    pointer-events: none;
    position: absolute;
    text-align: center;
  }

  .notes p {
    background: var(--color-bg);
    border-radius: var(--size-xs);
    inline-size: fit-content;
    margin: 0 auto var(--size-2xs);
    padding: var(--size-2xs) var(--size-xs);
  }

  .notes p:empty,
  .paused-notice {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .paused-notice {
      display: block;
    }
  }

  .fps {
    background: var(--color-bg);
    border-radius: var(--size-xs);
    display: grid;
    font-variant-numeric: tabular-nums;
    gap: 0.125rem;
    inset: auto var(--size-sm) max(var(--size-sm), env(safe-area-inset-bottom))
      auto;
    justify-items: end;
    padding: var(--size-2xs) var(--size-xs);
    position: fixed;
  }

  .fps[hidden] {
    display: none;
  }

  .fps p {
    margin: 0;
  }

  .fps svg {
    background: color-mix(in oklch, currentColor 12%, transparent);
    block-size: 1.25rem;
    inline-size: 6rem;
    margin-block-start: 0.25rem;
    overflow: visible;
  }

  polyline {
    fill: none;
    shape-rendering: crispEdges;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
</style>
