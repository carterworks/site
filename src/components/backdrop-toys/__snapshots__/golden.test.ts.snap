    "data-scale": "7",
    "data-shadow": "25",
    "data-shadow-x": "4",
    "data-shadow-y": "4",
    "data-shape": "square",
    "data-width": "160",
  },
  "canvasStyle": {
    "--emulated-canvas-scale": "max(1px, round(up, max(100lvw, 100lvh) / 160, 1px) - 2px)",
  },
  "stylesheet": [
    ":host {",
    "--scale: var(--emulated-canvas-scale, 7px);",
    "--stride: calc(var(--scale) + 2px);",
    "display: inline-block;",
    "line-height: 0;",
    "overflow: clip;",
    "position: relative;",
    "}",
    "canvas {",
    "image-rendering: pixelated;",
    "inline-size: calc(160 * var(--stride));",
    "block-size: calc(160 * var(--stride));",
    "margin: -1px -1px -1px -1px;",
    "vertical-align: top;",
    "}",
    ":host::after {",
    "background: repeating-linear-gradient(to right, var(--emulated-canvas-gap-color, Canvas) 0 1px, transparent 0 calc(1px + var(--scale)), var(--emulated-canvas-gap-color, Canvas) 0 var(--stride)), repeating-linear-gradient(to bottom, var(--emulated-canvas-gap-color, Canvas) 0 1px, transparent 0 calc(1px + var(--scale)), var(--emulated-canvas-gap-color, Canvas) 0 var(--stride));",
    "content: "";",
    "inset: -1px -1px -1px -1px;",
    "pointer-events: none;",
    "position: absolute;",
    "}",
    ":host {",
    "isolation: isolate;",
    "}",
    ".echo {",
    "inset: 0 auto auto 0;",
    "pointer-events: none;",
    "position: absolute;",
    "translate: 4px 4px;",
    "z-index: 1;",
    "}",
  ],
}
`;

