---
import "@carterworks/pixel-backdrop/pixel-backdrop.css";

const GRID_SIZE = 160;

/**
 * The site-wide pixel backdrop. `<pixel-backdrop>` is a fixed, non-interactive
 * layer that fills the viewport with a live `<emulated-canvas>`; the custom
 * element runs a toy on it, passes it the pointer and owns its tweakable
 * render knobs, and the site shows it the theme on `<html>`. The square bitmap
 * is sized to cover the viewport, so its pixel grid can never run out at the
 * edges.
 */
---

<pixel-backdrop aria-hidden="true" transition:persist>
  <emulated-canvas
    data-width={GRID_SIZE}
    data-height={GRID_SIZE}
    data-fit="viewport"></emulated-canvas>
</pixel-backdrop>

<script>
  // Ahead of the element's definition, so its first frame is in the theme.
  import "./follow-display";
  import "@carterworks/pixel-backdrop";
</script>
