---
import { GRID_SIZE } from "./backdrop-modes/mode";
import EmulatedCanvas from "./EmulatedCanvas.astro";

/**
 * The site-wide pixel backdrop. `<pixel-backdrop>` is a fixed, non-interactive
 * layer that fills the viewport with a live `<emulated-canvas>`; the custom
 * element drives it from pointer input and owns its tweakable render knobs.
 * The square bitmap is sized to cover the viewport, so its pixel grid can
 * never run out at the edges.
 */
---

<pixel-backdrop aria-hidden="true" transition:persist>
  <EmulatedCanvas width={GRID_SIZE} height={GRID_SIZE} />
  <div class="small-viewport"></div>
</pixel-backdrop>

<script>
  import "./pixel-backdrop";
</script>

<style>
  /* The large viewport, like the cell size, so mobile toolbars sliding in and
     out can't move the grid. */
  /* 100vw runs under a classic scrollbar, whose track is transparent, so the
     grid shows through it and is centred on the full viewport. */
  pixel-backdrop {
    block-size: 100lvh;
    display: block;
    inline-size: 100vw;
    inset: 0 auto auto 0;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    z-index: 0;
  }

  pixel-backdrop[data-disabled] {
    display: none;
  }

  /* Centre the oversized grid so its middle always covers the viewport. The
     offsets are rounded because a half-pixel shift would blur the gap overlay.
     The gaps are painted in the body colour that shows behind this layer. */
  pixel-backdrop :global(emulated-canvas) {
    --emulated-canvas-gap-color: var(--color-bg);
    inline-size: max-content;
    left: round(50%, 1px);
    position: absolute;
    top: round(50%, 1px);
    translate: round(-50%, 1px) round(-50%, 1px);
  }

  /* What the toys fit to: the area on screen even with the toolbars out, so
     they slide away without reshaping a toy. The safe areas come off because
     the status bar and iOS's floating toolbar may sit over the page there. */
  .small-viewport {
    block-size: calc(
      100svh - env(safe-area-inset-top) - env(safe-area-inset-bottom)
    );
    inline-size: calc(
      100svw - env(safe-area-inset-left) - env(safe-area-inset-right)
    );
    left: env(safe-area-inset-left);
    position: fixed;
    top: env(safe-area-inset-top);
    visibility: hidden;
  }

  /* A held finger would otherwise raise iOS's callout, and the overscroll is
     belt and braces for the touchmove the element already blocks. */
  :global(:root[data-backdrop-holding]) {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    overscroll-behavior: none;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    pixel-backdrop {
      display: none;
    }
  }
</style>
