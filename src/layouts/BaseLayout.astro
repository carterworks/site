---
import "./global.css";
import { ClientRouter } from "astro:transitions";
import CommandBar from "../components/command-bar/CommandBar.astro";
import InlineAvatar from "../components/InlineAvatar.astro";
import PixelBackdrop from "../components/pixel-backdrop/PixelBackdrop.astro";
import { restoreScript } from "../lib/color-scheme";
import {
  displayAttribute,
  displayColours,
  displayKey,
  displaysFor,
} from "../components/pixel-backdrop/backdrop-displays";
import { getPageMetadata, pages, type PageMetadata } from "../lib/pages";
interface Props {
  bare?: boolean;
  class?: string;
  metadata?: PageMetadata;
}
const { bare, class: className, metadata: pageMetadata } = Astro.props;
const metadata = pageMetadata ?? getPageMetadata(Astro.url.pathname);
if (!metadata?.title)
  throw new Error(`Missing page title: ${Astro.url.pathname}`);
const { title } = metadata;
const ogImage = new URL(`/og/${metadata.id}.webp`, Astro.site);
const fediverseCreator = "@literallyacar@mastodon.social";
const socialTitle = metadata.ogTitle ?? title;
const ogImageAlt = metadata.ogImageAlt ?? socialTitle;
const schemes = ["light", "dark"] as const;
const displays = schemes.map((scheme): [string, string] => [
  displayAttribute(scheme),
  displayKey(scheme),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/InterVariable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {
      schemes.map((scheme) => (
        <meta
          name="theme-color"
          media={`(prefers-color-scheme: ${scheme})`}
          content={displaysFor(scheme)[0].page.bg}
        />
      ))
    }
    <style is:inline set:html={displayColours()} />
    <script is:inline set:html={restoreScript(displays)} />

    <meta name="fediverse:creator" content={fediverseCreator} />
    <ClientRouter />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={pages["/blog/"].title}
      href="/blog/atom.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={pages["/blog/"].title}
      href="/blog/rss.xml"
    />
    <title>{title}</title>
    {
      metadata.description && (
        <meta name="description" content={metadata.description} />
      )
    }
    <meta property="og:title" content={socialTitle} />
    {
      metadata.description && (
        <meta property="og:description" content={metadata.description} />
      )
    }
    {metadata.ogType && <meta property="og:type" content={metadata.ogType} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    {
      metadata.description && (
        <meta name="twitter:description" content={metadata.description} />
      )
    }
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
  </head>
  <body>
    <PixelBackdrop />
    {
      bare ? (
        <slot />
      ) : (
        <div class="stack">
          <header>
            <a href="/">
              <strong view-transition-name="carter">
                <InlineAvatar
                  src="/assets/avatar-460.avif"
                  srcset="/assets/avatar-39.avif 39w, /assets/avatar-460.avif 460w"
                  sizes="39px"
                  width={39}
                  height={39}
                  alt="A headshot of Carter"
                />Carter McBride
              </strong>
            </a>
            <CommandBar />
          </header>
          <main class={className}>
            <slot />
          </main>
        </div>
      )
    }
  </body>
</html>

<style>
  /* The backdrop is a fixed layer at z-index 0; the content stacks above it. */
  .stack {
    position: relative;
    z-index: 1;
  }

  /* The header shares the base's width and padding so the two surfaces line up. */
  main,
  header {
    background: var(--color-bg);
    border-radius: var(--size-sm);
    /* The inline padding holds the hanging list markers; the matching negative
       margin keeps the text on its original column. The roomier value applies
       once the body gutters are wide enough to absorb it. */
    margin-inline: calc(var(--size-sm) * -1);
    padding-block: var(--size-sm);
    padding-inline: var(--size-md);
  }

  @media (min-width: 48rem) {
    main,
    header {
      margin-inline: calc(var(--size-lg) * -1);
      padding-inline: var(--size-lg);
    }
  }

  header {
    align-items: center;
    container-name: sticky-header;
    container-type: scroll-state;
    display: flex;
    justify-content: space-between;
    position: sticky;
    top: var(--size-sm);
    z-index: 1;
  }

  header::after {
    background: linear-gradient(var(--color-bg), transparent);
    block-size: var(--size-lg);
    content: "";
    inset: 100% 0 auto;
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  @container sticky-header scroll-state(stuck: top) {
    header::after {
      opacity: 1;
    }
  }
</style>
