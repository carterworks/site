---
import { render } from "astro:content";
import {
  getPostDescription,
  getPostTitle,
  getPublishedPosts,
} from "../../lib/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDateLong } from "../../lib/date";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const pubDateISO = entry.data.pubDate.toISOString();
const humanFriendlyDate = formatDateLong(entry.data.pubDate);
const title = getPostTitle(entry);
const pageTitle = `${title} | carter.works`;
const description = getPostDescription(entry);
---

<BaseLayout
  metadata={{
    description,
    id: entry.id,
    ogImage: `/og/${entry.id}.webp`,
    ogTitle: title,
    ogType: "article",
    title: pageTitle,
  }}
>
  <Fragment slot="head">
    <meta property="og:article:published_time" content={pubDateISO} />
    <meta property="og:article:author" content="Carter McBride" />
    <style is:global>
      article blockquote {
        border-inline-start: 2px solid black;
        padding-inline-start: var(--size-xs);
      }
    </style>
  </Fragment>
  <article class:list={["stack", remarkPluginFrontmatter.articleClass]}>
    <header class="stack">
      <h1>
        {entry.data.draft && "Rough Draft: "}{title}
      </h1>
      <p>
        <time datetime={pubDateISO}>{humanFriendlyDate}</time>
      </p>
    </header>
    <Content />
  </article>
</BaseLayout>
