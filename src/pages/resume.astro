    </p>
  </section>
</BaseLayout>

<style>
  :global(.resume) {
    --flow-space: var(--size-sm);

    display: grid;
    gap: var(--size-md);
  }

  /* The children take it, not main, whose padding and margins are in lh and
     match the header's. */
  @media screen {
    :global(.resume > *) {
      font-size: 1.125rem;
    }
  }

  h1 {
    font-size: 2em;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* Each item keeps its separator, so a wrapped line never starts with one. */
  .contact span {
    white-space: nowrap;
  }

  h2 {
    border-block-end: 1px solid;
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-block-end: 0.5em;
    padding-block-end: 0.25em;
    text-transform: uppercase;
  }

  h3 {
    align-items: baseline;
    column-gap: 1em;
    display: flex;
    font-size: 1em;
    font-weight: 600;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  h3 span {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: normal;
    white-space: nowrap;
  }

  article + article {
    margin-block-start: 0.6lh;
  }

  ul {
    padding-inline-start: 1.2em;
  }

  li {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a[href]::after {
    content: none;
  }

  @media print {
    @page {
      margin: 0.5in;
      size: letter;
    }

    :global(html) {
      color-scheme: light;
    }

    /* The site's body is a viewport-high grid that centres its content, and
       Chromium still honours that centring on a block container. */
    :global(body) {
      background: none;
      color: #000;
      display: block;
      min-height: 0;
      place-content: normal;
      container-type: inline-size;
    }

    :global(pixel-backdrop),
    :global(body > .stack > header) {
      display: none;
    }

    /* BaseLayout's scoped main rule outranks a bare .resume selector. Safari on
       iOS lays the page out about 590px wide where Chrome uses 720px, so a
       fixed size prints a fifth larger there; 54 ems to the line is 10pt on
       the 7.5in line in both. */
    :global(body main.resume) {
      background: none;
      font-size: calc(100cqi / 54);
      line-height: 1.35;
      margin: 0;
      padding: 0;
    }

    h2 {
      border-block-end-width: 0.5pt;
    }

    a {
      text-decoration: none;
    }
  }
</style>
