---
import BaseLayout from "../layouts/BaseLayout.astro";

// This page must print to exactly one US Letter page (see the print styles
// below): recruiters skim one page, and a second page that holds a stray line
// reads as careless. After any edit, print it to PDF and check the page count
// before committing; cut words rather than shrinking the type or margins.
// Safari on iOS prints narrower and shorter than Chrome, with wider side
// margins and its own footer, so leave about two lines spare at the bottom.
//
// Write experience bullets in Google's XYZ format, "Accomplished [X] as
// measured by [Y], by doing [Z]", one sentence of about two printed lines
// each, so every bullet states an outcome, its evidence, and the work that
// caused it rather than listing duties.
---

<BaseLayout class="resume">
  <hgroup>
    <h1>Carter McBride</h1>
