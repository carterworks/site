{
  "name": "@carterworks/pixel-backdrop",
  "version": "0.1.0",
  "description": "A live pixel-grid backdrop: generic canvas toys shown through an emulated LCD canvas.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carterworks/site.git",
    "directory": "packages/pixel-backdrop"
  },
  "customElements": "custom-elements.json",
  "exports": {
    ".": "./src/pixel-backdrop/element.ts",
